{
  "name": "gtfs-zone-homepage",
  "version": "0.9.0",
  "description": "Marketing homepage for gtfs.zone",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip",
    "knip": "knip",
    "lint": "eslint src/ scripts/ vite.config.ts --max-warnings 0",
    "lint:fix": "eslint src/ scripts/ vite.config.ts --fix",
    "format": "prettier --write src/ scripts/ *.ts",
    "bake": "tsx scripts/bake-network.ts",
    "vuln": "sh scripts/vuln-gate.sh",
    "commit": "cz commit"
  },
  "keywords": [
    "gtfs",
    "transit"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jszip": "^3.10.2",
    "knip": "^6.39.0",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "daisyui": "^5.7.46"
  }
}
